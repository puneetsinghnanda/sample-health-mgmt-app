# Hospital Management local settings. Copy to .env (git-ignored) and fill in your own values.
# Never commit a real connection string: it contains the database password.

# Your own Neon database branch (direct connection, not the "-pooler" host).
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-branch.ap-southeast-1.aws.neon.tech/hms?sslmode=require

API_HOST=127.0.0.1
API_PORT=3000
HOSPITAL_TZ=Asia/Kolkata

# Seed anchor: "now" (default) or a fixed ISO timestamp for repeatable demos.
SEED_ANCHOR=now

# Tests use a throwaway PostgreSQL 16, never the database above. Either have the PostgreSQL 16 binaries
# installed (PG_BIN, default /usr/lib/postgresql/16/bin) or point this at an admin URL of a local server.
# HMS_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
